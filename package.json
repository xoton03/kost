  },
  "homepage": "https://github.com/xoton03/kost#readme",
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "autoprefixer": "^10.4.19",
    "http-server": "^14.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
