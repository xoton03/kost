{
  "name": "ginder",
  "version": "1.0.0",
  "description": "K.O.S.T. Retail Stock PWA",
  "main": "app.js",
  "scripts": {
    "build:tailwind-main": "npx tailwindcss -i src/input.css -o tailwind.css -c tailwind.config.js",
    "build:tailwind-flo": "npx tailwindcss -i src/input.css -o tailwind-flo.css -c tailwind-flo.config.js",
    "build:tailwind-flo-screen": "npx tailwindcss -i src/input.css -o tailwind-flo-screen.css -c tailwind-flo-screen.config.js",
    "build:tailwind-tech": "npx tailwindcss -i src/input.css -o tailwind-tech.css -c tailwind-tech.config.js",
    "build": "npm run build:tailwind-main && npm run build:tailwind-flo && npm run build:tailwind-flo-screen && npm run build:tailwind-tech",
    "dev": "npm run build && http-server -p 8080"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoton03/kost.git"
  },
